# Point the Float dashboard at the NEAR adapter instead of the Solana backend.
# This is the ONLY configuration change the dashboard needs: same components,
# same logo, same styles, same screens.
#
# 8787 is already the dashboard's built-in default and is the adapter's port,
# so in local dev you can leave this unset entirely.
NEXT_PUBLIC_FLOAT_API_URL=http://127.0.0.1:8787

# The Solana-era vars below are no longer read. components/wallet-provider.tsx
# is a NEAR drop-in: owner actions are unsigned payloads approved in the
# owner's own wallet, so the dashboard never needs signing authority.
# NEXT_PUBLIC_PHANTOM_CONNECT_APP_ID=
# NEXT_PUBLIC_PHANTOM_CONNECT_REDIRECT_URL=
# NEXT_PUBLIC_SOLANA_RPC_URL=
