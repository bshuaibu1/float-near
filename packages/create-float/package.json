{
  "name": "@floatonnear/create-float",
  "version": "0.8.2",
  "description": "One command to stand up a Float vault on NEAR: account, contract, budget tree, agent keys, and client config.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "create-float": "bin/create-float.mjs",
    "float-exit": "bin/float-exit.mjs",
    "float-agent": "bin/float-agent.mjs",
    "float-topup": "bin/float-topup.mjs",
    "float-retire": "bin/float-retire.mjs"
  },
  "files": [
    "bin/",
    "res/",
    "scripts/",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "near-api-js": "^7.4.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "bundle-wasm": "node scripts/bundle-wasm.mjs",
    "prepack": "node scripts/bundle-wasm.mjs --assert-current && node -e \"require('fs').copyFileSync('../../SKILL.md','SKILL.md')\""
  }
}
