{
  "name": "@near-vault/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for the hierarchical budget vault. The agent key signs request_payment only; owner methods emit unsigned payloads for wallet approval.",
  "bin": {
    "near-vault-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "near-api-js": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": "./dist/index.js",
    "./amounts": "./dist/amounts.js",
    "./sign": "./dist/sign.js",
    "./payloads": "./dist/payloads.js"
  }
}
