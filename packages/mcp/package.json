{
  "name": "@floatonnear/mcp",
  "version": "0.10.0",
  "type": "module",
  "description": "MCP server for the hierarchical budget vault. The agent key signs request_payment only; owner methods emit unsigned payloads for wallet approval.",
  "license": "MIT",
  "bin": {
    "mcp": "dist/server.js",
    "float-mcp": "dist/server.js"
  },
  "files": [
    "dist/",
    "SKILL.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').copyFileSync('../../SKILL.md','SKILL.md')\" && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "near-api-js": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": "./dist/index.js",
    "./amounts": "./dist/amounts.js",
    "./sign": "./dist/sign.js",
    "./payloads": "./dist/payloads.js",
    "./quote": {
      "types": "./dist/quote.d.ts",
      "import": "./dist/quote.js"
    },
    "./key-file": {
      "types": "./dist/key-file.d.ts",
      "import": "./dist/key-file.js"
    }
  }
}
